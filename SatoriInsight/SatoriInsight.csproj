<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="PublishWithSatoriGC" Version="10.0.14-satori.40308415116.1" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EventSourceSupport>true</EventSourceSupport>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- .NET 11 RC2 optimized publish skips Avalonia's resource build: AvaloniaUI/Avalonia#22465. -->
    <UseOptimizedPublish>false</UseOptimizedPublish>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/SatoriInsight.ico</ApplicationIcon>
    <Title>Satori Insight</Title>
    <Product>Satori Insight</Product>
    <Version>1.1.3</Version>
    <AssemblyVersion>1.1.3.0</AssemblyVersion>
    <FileVersion>1.1.3.0</FileVersion>
    <UseAvaloniaPro Condition="'$(UseAvaloniaPro)' == '' and '$(AvaloniaUILicenseKey)' != ''">true</UseAvaloniaPro>
    <UseAvaloniaPro Condition="'$(UseAvaloniaPro)' == ''">false</UseAvaloniaPro>
    <DefineConstants Condition="'$(UseAvaloniaPro)' == 'true'">$(DefineConstants);AVALONIA_PRO</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="FluentAvaloniaUI" Version="3.1.0" />
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.750501" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="4.0.0" />
    <PackageReference Include="Microsoft.Diagnostics.Runtime" Version="4.2.751201" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup Condition="'$(UseAvaloniaPro)' == 'true'">
    <PackageReference Include="Avalonia.Controls.Charts" Version="12.3.1" />
    <PackageReference Include="Avalonia.Controls.Markdown" Version="12.3.1" />
    <AvaloniaUILicenseKey Include="$(AvaloniaUILicenseKey)" Condition="'$(AvaloniaUILicenseKey)' != ''" />
    <AvaloniaXaml Remove="Controls/Fallback/**/*.axaml" />
    <AvaloniaXaml Remove="Styles/Fallback/**/*.axaml" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseAvaloniaPro)' != 'true'">
    <AvaloniaXaml Remove="Controls/MemoryHistoryView.axaml;Controls/PauseHistogramView.axaml;Controls/UpdateAvailableDialog.axaml" />
    <AvaloniaXaml Remove="Styles/AvaloniaProStyles.axaml" />
    <AvaloniaXaml Update="Styles/Fallback/AvaloniaProStyles.axaml" Link="Styles/AvaloniaProStyles.axaml" />
  </ItemGroup>
</Project>
