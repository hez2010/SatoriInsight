<fa:FAContentDialog xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="using:FluentAvalonia.UI.Controls"
    xmlns:models="using:SatoriInsight.Models" x:DataType="models:AppUpdate" x:Class="SatoriInsight.Controls.UpdateAvailableDialog"
    Title="{Binding Title}" PrimaryButtonText="View release" CloseButtonText="Not now" DefaultButton="Primary">
    <fa:FAContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">680</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">760</x:Double>
    </fa:FAContentDialog.Resources>
    <Markdown Text="{Binding Changelog}" Width="640" Height="400" />
</fa:FAContentDialog>
