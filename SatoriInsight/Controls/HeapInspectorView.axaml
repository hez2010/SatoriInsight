<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:SatoriInsight.ViewModels"
    xmlns:models="using:SatoriInsight.Models" xmlns:local="using:SatoriInsight.Controls" x:DataType="vm:MainViewModel"
    x:Class="SatoriInsight.Controls.HeapInspectorView">
    <UserControl.Styles>
        <Style Selector="ComboBox.comparison-capture ComboBoxItem" x:DataType="models:HeapProfile">
            <Setter Property="IsEnabled" Value="{Binding !MetadataOnly}" />
        </Style>
        <Style Selector="Grid.heap-workspace">
            <Setter Property="Height" Value="430" />
        </Style>
        <Style Selector="Grid.heap-workspace.has-objects">
            <Setter Property="Height" Value="760" />
        </Style>
    </UserControl.Styles>
    <StackPanel Spacing="12">
        <WrapPanel>
            <Button Content="Capture heap" IsEnabled="{Binding CanCaptureHeap}" Click="Capture_Click" Classes="primary" Margin="0,0,8,8"
                ToolTip.Tip="Capturing a heap may briefly pause the process." />
            <Button Content="Open dump" Click="Dump_Click" IsEnabled="{Binding CanOpenDump}" Classes="secondary" Margin="0,0,8,8" />
            <Button Content="Cancel" Click="Cancel_Click" IsVisible="{Binding IsHeapBusy}" Classes="secondary" Margin="0,0,8,8" />
            <Button Content="Remove capture" Click="Remove_Click" IsEnabled="{Binding HasSnapshot}" Classes="secondary" Margin="0,0,8,8" />
            <ComboBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshot}" Width="270" Margin="0,0,8,8"
                PlaceholderText="Select a captured heap" AutomationProperties.Name="Capture to inspect">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:HeapProfile"><TextBlock Text="{Binding Label}" /></DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="Clear filters" Click="AllTypes_Click" IsEnabled="{Binding HasHeapFilter}" Classes="secondary" Margin="0,0,8,8" />
        </WrapPanel>
        <TextBlock Text="{Binding CaptureSourceLabel}" TextWrapping="Wrap" Classes="muted" FontSize="11" />
        <TextBlock IsVisible="{Binding HasHeapStatus}" Text="{Binding HeapStatus}" TextWrapping="Wrap" Classes="muted" />
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsHeapBusy}" />
        <Grid Name="HeapWorkspace" Classes="heap-workspace" Classes.has-objects="{Binding HasObjectCapture}"
            IsVisible="{Binding HasSnapshot}" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="360" />
                <ColumnDefinition Width="8" MinWidth="8" MaxWidth="8" />
                <ColumnDefinition Width="6*" MinWidth="400" />
            </Grid.ColumnDefinitions>
            <Grid Name="HeapNavigationPane" RowDefinitions="Auto,8,*" ClipToBounds="True">
                <local:CapturedRegionPicker Name="CapturedRegions" DataContext="{Binding CapturedRegionMap}" RegionFocused="Region_Focused" />
                <Grid Grid.Row="2" IsVisible="{Binding HasObjectCapture}" ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="130" />
                        <RowDefinition Height="8" MinHeight="8" MaxHeight="8" />
                        <RowDefinition Height="*" MinHeight="130" />
                    </Grid.RowDefinitions>
                    <Border Classes="panel" Padding="12" ClipToBounds="True">
                        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                            <TextBlock Text="Types" FontWeight="SemiBold" />
                            <TextBox Grid.Row="1" Text="{Binding TypeSearch}" PlaceholderText="Filter types" AutomationProperties.Name="Filter captured types" />
                            <DataGrid Grid.Row="2" Name="TypesGrid" ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}"
                                IsReadOnly="True" AutoGenerateColumns="False" PointerReleased="Object_Focused" GotFocus="Object_Focused">
                                <DataGrid.Columns>
                                    <DataGridTextColumn x:DataType="models:TypeStat" Header="Type" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn x:DataType="models:TypeStat" Header="Count" Binding="{Binding CountLabel}" SortMemberPath="Count" Width="75" />
                                    <DataGridTextColumn x:DataType="models:TypeStat" Header="Bytes" Binding="{Binding SizeLabel}" SortMemberPath="Bytes" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                    <GridSplitter Grid.Row="1" Name="ObjectListSplitter" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" />
                    <Border Grid.Row="2" Classes="panel" Padding="12" ClipToBounds="True">
                        <Grid RowDefinitions="Auto,*" RowSpacing="8">
                            <TextBlock Text="{Binding ObjectCountLabel}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ObjectCountLabel}" FontWeight="SemiBold" />
                            <DataGrid Grid.Row="1" Name="ObjectsGrid" ItemsSource="{Binding Objects}" SelectedItem="{Binding SelectedObject}"
                                IsReadOnly="True" AutoGenerateColumns="False" SelectionChanged="RevealSelectedObject" Loaded="RevealSelectedObject"
                                PointerReleased="Object_Focused" GotFocus="Object_Focused">
                                <DataGrid.Columns>
                                    <DataGridTextColumn x:DataType="models:HeapObjectInfo" Header="Address" Binding="{Binding AddressLabel}" SortMemberPath="Address" Width="145" />
                                    <DataGridTextColumn x:DataType="models:HeapObjectInfo" Header="Type" Binding="{Binding Type}" Width="*" />
                                    <DataGridTextColumn x:DataType="models:HeapObjectInfo" Header="Size" Binding="{Binding SizeLabel}" SortMemberPath="Size" Width="90" />
                                    <DataGridTextColumn x:DataType="models:HeapObjectInfo" Header="Gen" Binding="{Binding GenerationLabel}" SortMemberPath="Generation" Width="70" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            <GridSplitter Grid.Column="1" Name="HeapPaneSplitter" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" />
            <Border Grid.Column="2" Name="HeapDetailsPane" Classes="panel" Padding="16" ClipToBounds="True">
                <Grid>
                    <Grid Name="ObjectDetailsPanel" IsVisible="{Binding !IsRegionInspection}" RowDefinitions="Auto,Auto,2*,Auto,3*" RowSpacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Object details" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ObjectSummary}" TextWrapping="Wrap" FontSize="12" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="← Back" Click="Back_Click" IsEnabled="{Binding CanGoBackToObject}" Classes="secondary" VerticalAlignment="Top" />
                        </Grid>
                        <TextBlock Grid.Row="1" Text="References" FontWeight="SemiBold" />
                        <DataGrid Grid.Row="2" Name="ReferencesGrid" ItemsSource="{Binding ObjectReferences}" SelectedItem="{Binding SelectedReference}"
                            IsReadOnly="True" AutoGenerateColumns="False" DoubleTapped="Reference_DoubleTapped" KeyDown="Reference_KeyDown"
                            ToolTip.Tip="Double-click or press Enter to inspect a referenced object.">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:DataType="models:ObjectReference" Header="Field / reference" Binding="{Binding Field}" Width="*" />
                                <DataGridTextColumn x:DataType="models:ObjectReference" Header="Address" Binding="{Binding Address, StringFormat=0x{0:X}}" SortMemberPath="Address" Width="155" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="3" Spacing="5">
                            <TextBlock Text="Root path" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding RootPathStatus}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                            <ProgressBar IsVisible="{Binding IsFindingRoot}" IsIndeterminate="True" Height="3" />
                        </StackPanel>
                        <DataGrid Grid.Row="4" Name="RootPathGrid" ItemsSource="{Binding RootPath}" IsReadOnly="True" AutoGenerateColumns="False"
                            DoubleTapped="RootPath_DoubleTapped" KeyDown="RootPath_KeyDown" ToolTip.Tip="Double-click or press Enter to inspect an object on this path.">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:DataType="models:RootPathStep" Header="#" Binding="{Binding Depth}" SortMemberPath="Depth" Width="45" />
                                <DataGridTextColumn x:DataType="models:RootPathStep" Header="Root / reference" Binding="{Binding Link}" Width="*" />
                                <DataGridTextColumn x:DataType="models:RootPathStep" Header="Address" Binding="{Binding AddressLabel}" SortMemberPath="Address" Width="155" />
                                <DataGridTextColumn x:DataType="models:RootPathStep" Header="Type" Binding="{Binding Type}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    <Grid Name="RegionDetailsPanel" IsVisible="{Binding IsRegionInspection}">
                        <Grid DataContext="{Binding CapturedRegionMap}" x:DataType="vm:RegionMapViewModel"
                            RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="12">
                            <TextBlock Text="Region details" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Text="{Binding RegionSummary}" TextWrapping="Wrap" FontSize="12" LineHeight="19" />
                            <local:FragmentStrip Grid.Row="2" Region="{Binding SelectedRegion}" Holes="{Binding RegionHoles}" Objects="{Binding RegionLayoutObjects}" Height="36" />
                            <ItemsControl Grid.Row="3" ItemsSource="{Binding RegionLayoutLegend}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:RegionLayoutLegendItem">
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,12,0">
                                            <Border Width="12" Height="12" Background="{Binding Brush}" BorderBrush="#8A97AB" BorderThickness="0.5" CornerRadius="2" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Label}" Classes="muted" FontSize="11" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DataGrid Grid.Row="4" Name="RegionHolesGrid" IsVisible="{Binding HasObjectCapture}" ItemsSource="{Binding RegionHoles}"
                                IsReadOnly="True" AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn x:DataType="models:FreeHole" Header="Free hole address" Binding="{Binding AddressLabel}" SortMemberPath="Address" Width="*" />
                                    <DataGridTextColumn x:DataType="models:FreeHole" Header="Size" Binding="{Binding SizeLabel}" SortMemberPath="Size" Width="120" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <Expander Name="ComparisonSection" Header="Compare captures" IsVisible="{Binding HasObjectCapture}" HorizontalContentAlignment="Stretch">
<StackPanel Spacing="12" Margin="0,16,0,0">
                    <Grid ColumnDefinitions="320,320" ColumnSpacing="16" HorizontalAlignment="Left">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Baseline" />
                            <ComboBox Name="BaselineCapturePicker" Classes="comparison-capture" ItemsSource="{Binding Snapshots}"
                                SelectedItem="{Binding BaselineSnapshot}" HorizontalAlignment="Stretch" PlaceholderText="Select a baseline"
                                AutomationProperties.Name="Baseline capture">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:HeapProfile">
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Compare with" />
                            <ComboBox Name="ComparisonCapturePicker" Classes="comparison-capture" ItemsSource="{Binding Snapshots}"
                                SelectedItem="{Binding SelectedSnapshot}" HorizontalAlignment="Stretch" PlaceholderText="Select a capture"
                                AutomationProperties.Name="Comparison capture">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:HeapProfile">
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Shallow size by type" Classes="muted" />
                    <TextBlock Text="{Binding ComparisonHint}" IsVisible="{Binding !HasComparison}" Classes="muted" TextWrapping="Wrap" />
                    <DataGrid Name="TypeDifferencesGrid" IsVisible="{Binding HasComparison}" ItemsSource="{Binding TypeDifferences}"
                        Height="450" IsReadOnly="True" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:DataType="models:TypeGrowth" Header="Type" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn x:DataType="models:TypeGrowth" Header="Baseline" Binding="{Binding BaselineLabel}" SortMemberPath="BaselineBytes" Width="160" />
                            <DataGridTextColumn x:DataType="models:TypeGrowth" Header="Selected" Binding="{Binding CurrentLabel}" SortMemberPath="CurrentBytes" Width="160" />
                            <DataGridTextColumn x:DataType="models:TypeGrowth" Header="Change" Binding="{Binding DeltaLabel}" SortMemberPath="DeltaBytes" Width="160" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
